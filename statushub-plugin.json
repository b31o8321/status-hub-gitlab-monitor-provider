{
  "id": "gitlab-monitor",
  "title": "GitLab Monitor",
  "version": "0.1.2",
  "providers": [
    {
      "id": "pipelines",
      "title": "GitLab Pipelines",
      "icon": "assets/gitlab-icon.svg",
      "statusFile": "runtime/status.json",
      "configFile": "runtime/config.json",
      "command": "bin/gitlab-monitor-provider",
      "arguments": [],
      "workingDirectory": ".",
      "configuration": [
        {
          "id": "gitlab",
          "title": "GitLab",
          "fields": [
            {
              "key": "gitlab.baseUrl",
              "title": "GitLab 地址",
              "type": "text",
              "defaultValue": "https://gitlab.com",
              "placeholder": "https://gitlab.example.com"
            },
            {
              "key": "gitlab.accessToken",
              "title": "Access Token",
              "type": "password",
              "placeholder": "glpat-..."
            },
            {
              "key": "refreshIntervalSeconds",
              "title": "刷新间隔",
              "type": "number",
              "defaultValue": "60",
              "placeholder": "60",
              "help": "单位：秒"
            },
            {
              "key": "repositories",
              "title": "仓库列表",
              "type": "textarea",
              "placeholder": "[{\"id\":\"group/project\",\"name\":\"Project\",\"branches\":[{\"selector\":{\"type\":\"fixed\",\"value\":\"main\"}}]}]",
              "help": "JSON 数组。支持旧版 branch，也支持 branches 多分支和 fixed/rule/regex selector"
            }
          ]
        }
      ]
    }
  ]
}
