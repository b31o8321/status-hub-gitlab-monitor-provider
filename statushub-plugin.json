{
  "id": "gitlab-monitor",
  "title": "GitLab Monitor",
  "version": "0.1.3",
  "providers": [
    {
      "id": "pipelines",
      "title": "GitLab Pipelines",
      "icon": "assets/gitlab-icon.svg",
      "statusFile": "runtime/status.json",
      "configFile": "runtime/config.json",
      "command": "bin/gitlab-monitor-provider",
      "arguments": [],
      "workingDirectory": ".",
      "configuration": [
        {
          "id": "gitlab",
          "title": "GitLab",
          "fields": [
            {
              "key": "gitlab.baseUrl",
              "title": "GitLab 地址",
              "type": "text",
              "defaultValue": "https://gitlab.com",
              "placeholder": "https://gitlab.example.com"
            },
            {
              "key": "gitlab.accessToken",
              "title": "Access Token",
              "type": "password",
              "placeholder": "glpat-..."
            },
            {
              "key": "refreshIntervalSeconds",
              "title": "刷新间隔",
              "type": "number",
              "defaultValue": "60",
              "placeholder": "60",
              "help": "单位：秒"
            },
            {
              "key": "repositories",
              "title": "监控项目",
              "type": "externalConfig",
              "placeholder": "选择项目和分支",
              "help": "打开 GitLab 项目搜索和分支选择器；保存后会写入当前 Provider 配置",
              "command": "bin/gitlab-configurator",
              "arguments": [],
              "workingDirectory": "."
            }
          ]
        }
      ]
    }
  ]
}
